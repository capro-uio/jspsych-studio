{
  "name": "jspsych-studio",
  "private": true,
  "description": "A no-code builder for jsPsych experiments: author in the browser, export readable jsPsych you can host anywhere.",
  "keywords": [
    "jsPsych",
    "psychology",
    "behavioural experiments",
    "online experiments",
    "no-code"
  ],
  "homepage": "https://www.capro.dev/jspsych-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capro-uio/jspsych-studio.git"
  },
  "bugs": {
    "url": "https://github.com/capro-uio/jspsych-studio/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run test --workspaces --if-present -- --coverage",
    "schemas": "npm run build --workspace @jspsych-studio/schemas",
    "spec-schema": "npm run spec-schema --workspace @jspsych-studio/compiler",
    "codemeta": "npm run codemeta --workspace @jspsych-studio/compiler",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/schemas/tsconfig.json && tsc -p packages/compiler/tsconfig.json && npm run check --workspace @jspsych-studio/studio",
    "dev": "npm run dev --workspace @jspsych-studio/studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vite": "$vite"
  }
}
