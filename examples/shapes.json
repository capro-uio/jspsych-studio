{
  "$schema": "https://www.capro.dev/jspsych-studio/spec-schema.json",
  "name": "shapes-demo",
  "data": {
    "save": "download"
  },
  "assets": [
    {
      "name": "blue-square.png",
      "url": "data:image/png;base64,"
    },
    {
      "name": "blue-circle.png",
      "url": "data:image/png;base64,"
    },
    {
      "name": "orange-square.png",
      "url": "data:image/png;base64,"
    },
    {
      "name": "orange-circle.png",
      "url": "data:image/png;base64,"
    }
  ],
  "conditions": {
    "shape_trials": [
      {
        "image": "blue-square.png",
        "shape": "square",
        "colour": "blue",
        "answer": "f"
      },
      {
        "image": "orange-circle.png",
        "shape": "circle",
        "colour": "orange",
        "answer": "j"
      },
      {
        "image": "orange-square.png",
        "shape": "square",
        "colour": "orange",
        "answer": "f"
      },
      {
        "image": "blue-circle.png",
        "shape": "circle",
        "colour": "blue",
        "answer": "j"
      }
    ]
  },
  "timeline": [
    {
      "kind": "trial",
      "plugin": "instructions",
      "params": {
        "pages": [
          "<p>You will see a coloured shape on each trial.</p><p>Press <b>f</b> for a <b>square</b>, <b>j</b> for a <b>circle</b>.</p>",
          "<p>The colour does not matter — judge the shape only.</p><p>Answer as quickly as you can without making mistakes.</p>"
        ],
        "show_clickable_nav": true
      }
    },
    {
      "kind": "checkpoint",
      "name": "instructions-read"
    },
    {
      "kind": "block",
      "conditions": "shape_trials",
      "randomize_order": true,
      "repetitions": 3,
      "children": [
        {
          "kind": "trial",
          "plugin": "html-keyboard-response",
          "params": {
            "stimulus": "<p style=font-size:48px>+</p>",
            "choices": "NO_KEYS",
            "trial_duration": 400
          }
        },
        {
          "kind": "trial",
          "plugin": "image-keyboard-response",
          "tag": "shapes",
          "params": {
            "stimulus": {
              "var": "image"
            },
            "stimulus_height": 200,
            "choices": ["f", "j"]
          },
          "record": {
            "shape": {
              "var": "shape"
            },
            "colour": {
              "var": "colour"
            }
          },
          "score": {
            "correct_if_response_equals": {
              "var": "answer"
            }
          }
        }
      ]
    }
  ]
}
