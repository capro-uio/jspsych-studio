{
  "$schema": "https://www.capro.dev/tachisto/spec-schema.json",
  "name": "stroop-demo",
  "data": {
    "save": "download"
  },
  "conditions": {
    "stroop_trials": [
      {
        "word": "RED",
        "ink": "red",
        "answer": "r",
        "congruency": "congruent",
        "stimulus": "<p style='font-size:48px;color:red'>RED</p>"
      },
      {
        "word": "BLUE",
        "ink": "blue",
        "answer": "b",
        "congruency": "congruent",
        "stimulus": "<p style='font-size:48px;color:blue'>BLUE</p>"
      },
      {
        "word": "RED",
        "ink": "blue",
        "answer": "b",
        "congruency": "incongruent",
        "stimulus": "<p style='font-size:48px;color:blue'>RED</p>"
      },
      {
        "word": "BLUE",
        "ink": "red",
        "answer": "r",
        "congruency": "incongruent",
        "stimulus": "<p style='font-size:48px;color:red'>BLUE</p>"
      }
    ]
  },
  "timeline": [
    {
      "kind": "trial",
      "plugin": "instructions",
      "params": {
        "pages": [
          "<p>You will see colour words printed in colour.</p><p>Press <b>r</b> if the ink is red, <b>b</b> if the ink is blue.</p>",
          "<p>Answer as quickly as you can without making mistakes.</p>"
        ],
        "show_clickable_nav": true
      }
    },
    {
      "kind": "checkpoint",
      "name": "instructions-read"
    },
    {
      "kind": "block",
      "conditions": "stroop_trials",
      "randomize_order": true,
      "repetitions": 2,
      "children": [
        {
          "kind": "trial",
          "plugin": "html-keyboard-response",
          "params": {
            "stimulus": "<p style='font-size:48px'>+</p>",
            "choices": "NO_KEYS",
            "trial_duration": 300
          }
        },
        {
          "kind": "trial",
          "plugin": "html-keyboard-response",
          "tag": "stroop",
          "params": {
            "stimulus": {
              "var": "stimulus"
            },
            "choices": ["r", "b"]
          },
          "record": {
            "congruency": {
              "var": "congruency"
            },
            "ink": {
              "var": "ink"
            }
          },
          "score": {
            "correct_if_response_equals": {
              "var": "answer"
            }
          }
        }
      ]
    }
  ]
}
